; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="officemasks"
run/main_scene="uid://bdyg1hhxwoxkp"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

TasksManager="*uid://bc2k5qrsgfgeb"
CinematicCamera="*uid://lmafwiml0rao"
DialogueManager="*uid://c3rodes2l3gxb"
Global="*uid://durbocb2wk5y7"
InteractionManager="*uid://dnqm326fad5k1"

[dialogue_manager]

runtime/balloon_path="res://scenes/ui/dialog_ballon/balloon.tscn"

[display]

window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="E:/Proyectos/Godot/recordings/lateral_movement.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

