[sub_resource type="GDScript" id="GDScript_v1bdg"]
script/source = "extends CanvasLayer
@onready var end: AnimationPlayer = $End
@onready var vignette: Vignette = $Main/Vignette

func _ready() -> void:
	end.animation_finished.connect(on_end_anim)

func on_end_anim(anim):
	await get_tree().create_timer(3).timeout
	Global.reset_game()
	pass

func fade_to_end():
	vignette.fade_in()
	await vignette.anim.animation_finished
	end.play(\"end\")
	pass
"

