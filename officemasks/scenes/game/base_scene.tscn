[sub_resource type="GDScript" id="GDScript_k82pn"]
resource_name = "compu"
script/source = "extends Area2D
@onready var interaction_area: InteractionArea = $InteractionArea

@export var dialog: DialogueResource

var used: bool = false
var is_locked: bool = true

func _ready() -> void:
	interaction_area.interact = Callable(self, \"_on_use\")
	MinigamesManager.connected_game_end.connect(on_end_game)
	MinigamesManager.click_point_end.connect(on_end_game)
	pass

func _on_use():
	if is_locked: return
	if used: return
	used = true
	MinigamesManager.load_click_and_point()
	pass

func on_end_game():
	DialogueManager.show_dialogue_balloon(dialog)
	pass


func _on_leandro_on_main_dialog_end() -> void:
	is_locked = false
	pass # Replace with function body.
"

