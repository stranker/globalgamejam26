[sub_resource type="GDScript" id="GDScript_udrqi"]
resource_name = "planti.gd"
script/source = "extends AnimatedSprite2D

var player: Player
@onready var water: CPUParticles2D = $Water

func _ready() -> void:
	Global.planti_regada.connect(on_planti_regada)

func _process(delta: float) -> void:
	if not player:
		player = get_tree().get_first_node_in_group(\"Player\")
	else:
		flip_h = global_position.direction_to(player.global_position).x > 0.1

func on_planti_regada(regada: bool):
	if regada:
		play(\"regada\")
		water.emitting = true
	else:
		play(\"no_regada\")
	pass
"

