[sub_resource type="GDScript" id="GDScript_ed5qc"]
resource_name = "Ending"
script/source = "extends Node2D

@export var bad_dialog: DialogueResource
@export var good_dialog: DialogueResource

func _ready() -> void:
	Global.bad_ending.connect(on_bad_ending)
	Global.good_ending.connect(on_good_ending)
	DialogueManager.dialogue_ended.connect(on_dialog_ended)
	pass

func on_bad_ending():
	DialogueManager.show_dialogue_balloon(bad_dialog)
	pass

func on_good_ending():
	DialogueManager.show_dialogue_balloon(good_dialog)
	pass

func on_dialog_ended(dialog):
	if dialog == bad_dialog or dialog == good_dialog:
		await get_tree().create_timer(0.5)
		get_tree().call_group(\"UI\", \"fade_to_end\")
	pass
"

